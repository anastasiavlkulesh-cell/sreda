{
  "name": "sreda",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "NODE_OPTIONS=--conditions=react-server tsx prisma/seed.ts",
    "db:offline:create": "node --no-warnings scripts/prisma-offline.mjs create",
    "db:offline:deploy": "node --no-warnings scripts/prisma-offline.mjs deploy",
    "db:offline:generate": "PRISMA_SCHEMA_ENGINE_BINARY=/bin/false prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1172.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.10",
    "lucide-react": "1.76.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.6.0",
    "pdfkit": "0.20.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.11.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@prisma/schema-engine-wasm": "8.1.0-1.d1b3f377ca835d73fd50954a5e22128b9ebdd6b8",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "nodemailer": "10.6.0"
  }
}
