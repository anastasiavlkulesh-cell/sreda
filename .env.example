# --- База данных ---
DATABASE_URL="postgresql://sreda:sreda@localhost:5432/sreda"

# --- Авторизация (Auth.js v5) ---
# Сгенерировать: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true
APP_URL="http://localhost:3000"

# --- Шифрование чувствительных полей (AES-256-GCM, 32 байта в base64) ---
# Сгенерировать: openssl rand -base64 32
DATA_ENCRYPTION_KEY=""

# --- Файловое хранилище: "local" или "s3" ---
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"
S3_ENDPOINT=""
S3_REGION="ru-central1"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- AI-провайдер: "rules" (встроенный алгоритмический анализ, без внешних вызовов)
#     или "openai-compatible" (любой API с протоколом /chat/completions:
#     YandexGPT через совместимый шлюз, GigaChat-прокси, OpenAI, локальная модель)
AI_PROVIDER="rules"
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# --- Уведомления ---
SMTP_URL=""            # например smtp://user:pass@smtp.yandex.ru:465
SMTP_FROM="СРЕДА <no-reply@example.ru>"
TELEGRAM_BOT_TOKEN=""

# --- Фоновые задачи (вызов /api/cron/* из планировщика) ---
CRON_SECRET=""
